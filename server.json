{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.DevinoSolutions/upapi-mcp",
  "title": "upAPI",
  "description": "upAPI operations and account management as MCP tools: search, scraping, PDF, OCR, billing, keys.",
  "repository": {
    "url": "https://github.com/DevinoSolutions/upapi-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "websiteUrl": "https://upapi.io/docs",
  "icons": [
    {
      "src": "https://upapi.io/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://upapi.io/logos/upAPI-icon-duotone-dark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    },
    {
      "src": "https://upapi.io/logos/upAPI-icon-white.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "dark"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.upapi.io/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@upapi/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "UPAPI_API_KEY",
          "description": "upAPI API key (starts with upapi_). No key yet? Connect the hosted server and ask your agent to run create_api_key.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "UPAPI_TOOL_MODE",
          "description": "Tool table: compact (default), directory (curated named tools) or full.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
